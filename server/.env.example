# Copy to `.env` in this folder. Never commit `.env`.

PORT=8787

# Same project as the app (hosted or local Supabase).
SUPABASE_URL=http://127.0.0.1:54321

# From Supabase dashboard (hosted) or `supabase status -o env` (local).
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret used by Supabase to verify HS256 JWTs (`supabase status -o env` → JWT_SECRET).
SUPABASE_JWT_SECRET=
