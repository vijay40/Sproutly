# Copy to `packages/server/.env` **or** put the same keys in the repo-root `.env` / `.env.local`.
# The server loads both (root first, then this package; package file wins on duplicate keys).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Optional
PORT=8787
NODE_ENV=development

# Logging (see wiki/entities/servers/rest-server.md)
# LOG_DIR defaults to repo-root logs/ (gitignored). Absolute path recommended in production.
# LOG_DIR=/var/log/sproutly
LOG_LEVEL=debug
# LOG_TO_FILE=false
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=14d
# LOG_ZIP_ARCHIVE=true
# LOG_SILENT=true
