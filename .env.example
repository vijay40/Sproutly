EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Kid pairing: small Node server in `server/` (not Supabase Edge). Run: `npm run pairing-server`
# Local dev: simulator on same machine → http://127.0.0.1:8787
# Physical iPhone → http://<YOUR_MAC_LAN_IP>:8787 (pairing server must listen on 0.0.0.0 in production)
EXPO_PUBLIC_PAIRING_SERVER_URL=http://127.0.0.1:8787
# Local Supabase (HTTP + anon from `supabase status -o env`):
#   iOS Simulator / web on same machine → http://127.0.0.1:54321
#   Android Emulator → http://10.0.2.2:54321 (host loopback)
#   Physical phone/tablet → http://<YOUR_MAC_LAN_IP>:54321 (same Wi‑Fi; not 127.0.0.1)
#
# Google sign-in (Dashboard → Authentication → Providers → Google): enable, add Web client ID + secret.
# In Google Cloud Console (OAuth client type “Web application”), add Authorized redirect URI:
#   https://<YOUR_PROJECT_REF>.supabase.co/auth/v1/callback
#
# URL Configuration (Authentication): allow OAuth return to the app (same as before for deep links):
#   Site URL: sproutly://auth-callback
#   Redirect URLs:
#     sproutly://auth-callback
#     sproutly://**
#     exp://**
#     https://auth.expo.io/**
#   Local `supabase/config.toml` auth URLs: after edits run `supabase stop && supabase start`.
